    "@opencode/client": "2.1.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11"
  }
}
